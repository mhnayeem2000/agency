# Copy this file to .env on the server and replace the placeholder values.
SECRET_KEY=replace-with-a-unique-secret-key
DEBUG=False
ALLOWED_HOSTS=brightabroadchina.webnestle.com
CSRF_TRUSTED_ORIGINS=https://brightabroadchina.webnestle.com

# Turn these on only after HTTPS/AutoSSL is active for the subdomain.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# SQLite works for a small cPanel deployment. For MySQL, set DB_ENGINE=mysql
# and fill in the cPanel database name, user and password below.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# DB_ENGINE=mysql
# DB_NAME=cpanelprefix_brightabroad
# DB_USER=cpanelprefix_dbuser
# DB_PASSWORD=replace-with-database-password
# DB_HOST=localhost
# DB_PORT=3306

# Optional SMTP. Leave EMAIL_HOST empty to print email to the application console.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=Bright Abroad China <no-reply@brightabroadchina.webnestle.com>
